<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
      Assigns Scribe_Change_Log_Record_Page as the org-default Lightning record
      page. Record-page assignment is an ActionOverride on View with type
      Flexipage; a flexipage without this is invisible to users.
    -->
    <actionOverrides>
        <actionName>View</actionName>
        <comment>Scribe: org-default Lightning record page.</comment>
        <content>Scribe_Change_Log_Record_Page</content>
        <formFactor>Large</formFactor>
        <skipRecordTypeSelect>false</skipRecordTypeSelect>
        <type>Flexipage</type>
    </actionOverrides>
    <compactLayoutAssignment>Scribe_Change_Log_Compact</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>The audit backbone. One record per action Scribe takes (field update, task created, contact created, call logged, stage-gap task). The single source of truth for everything Scribe has ever done, independent of how it is viewed.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Scribe Change Log</label>
    <nameField>
        <displayFormat>CHG-{00000}</displayFormat>
        <label>Change Log Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Scribe Change Logs</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
