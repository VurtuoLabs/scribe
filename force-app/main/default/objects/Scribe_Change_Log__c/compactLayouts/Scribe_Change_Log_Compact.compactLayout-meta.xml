<?xml version="1.0" encoding="UTF-8"?>
<CompactLayout xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Scribe_Change_Log_Compact</fullName>
    <!--
      The record name is an auto-number (CHG-00001). These fields make a hover or
      a Kanban card say what Scribe did, to what, and whether a human approved it.
      Old_Value__c / New_Value__c are long text areas, which compact layouts do
      not support, so the diff itself lives on the record page instead.
    -->
    <fields>Name</fields>
    <fields>Change_Type__c</fields>
    <fields>Object_API_Name__c</fields>
    <fields>Related_Record_Name__c</fields>
    <fields>Field_Name__c</fields>
    <fields>Rep_Confirmed__c</fields>
    <fields>Source_Call_Log__c</fields>
    <fields>Created_By_Rep__c</fields>
    <label>Scribe Change Log Compact</label>
</CompactLayout>
