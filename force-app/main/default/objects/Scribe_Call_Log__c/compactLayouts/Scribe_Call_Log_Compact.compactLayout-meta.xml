<?xml version="1.0" encoding="UTF-8"?>
<CompactLayout xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Scribe_Call_Log_Compact</fullName>
    <!--
      Drives lookup hovers, the mobile record header, Kanban cards and list-view
      previews. The record name is an auto-number (CALL-00001), so on its own it
      says nothing; these fields answer "which deal, when, how did it go".
      Call_Summary__c and Extraction_JSON__c are long text areas, which compact
      layouts do not support, so the recap itself is not here.
    -->
    <fields>Name</fields>
    <fields>Opportunity__c</fields>
    <fields>Call_Date__c</fields>
    <fields>Sentiment__c</fields>
    <fields>Stage_At_Log__c</fields>
    <fields>Source_Channel__c</fields>
    <fields>Logged_By_Rep__c</fields>
    <label>Scribe Call Log Compact</label>
</CompactLayout>
